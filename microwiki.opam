# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A simple wiki engine"
description:
  "A simple project to learn OCaml by building a wiki engine with Dream and Caqti"
authors: ["Chris Szabo <mail@krisztianszabo.com>"]
license: "MIT"
depends: [
  "dune" {>= "3.23"}
  "ocaml"
  "dream"
  "caqti"
  "caqti-lwt"
  "caqti-driver-sqlite3"
  "str"
  "alcotest"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
